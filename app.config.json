{
  "$schema": "./schemas/app-config.schema.json",
  "name": "Time Study Desk",
  "nameJa": "動画作業分析",
  "slug": "time-study-desk",
  "version": "0.3.0",
  "description": "Measure repeated work cycles in a local video, preserve procedure changes and save analysis JSON.",
  "descriptionJa": "動画の作業を工程・回ごとに区切り、手順を変更しても過去の記録を保って分析データを保存します。",
  "defaultLanguage": "auto",
  "repository": {
    "owner": "ttomohisa",
    "name": "htmlapps-time-study-desk"
  },
  "build": {
    "output": "dist/index.html",
    "blockRuntimeNetwork": true,
    "selfExtract": {
      "enabled": true,
      "output": "dist/index.self-extract.html"
    },
    "sizeBudget": {
      "readableWarningMb": 2,
      "selfExtractWarningMb": 1
    }
  }
}
