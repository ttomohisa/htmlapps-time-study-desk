{
  "$schema": "./schemas/app-config.schema.json",
  "name": "Time Study Desk",
  "nameJa": "動画作業分析",
  "slug": "time-study-desk",
  "version": "0.4.0",
  "description": "Measure local work videos with interruptions and missing observations; review intervals and save analysis JSON.",
  "descriptionJa": "作業動画を工程・回ごとに区切り、中断や未観測を分けて記録し、区間を修正して分析データを保存します。",
  "defaultLanguage": "auto",
  "repository": {
    "owner": "ttomohisa",
    "name": "htmlapps-time-study-desk"
  },
  "build": {
    "output": "dist/index.html",
    "blockRuntimeNetwork": true,
    "selfExtract": {
      "enabled": true,
      "output": "dist/index.self-extract.html"
    },
    "sizeBudget": {
      "readableWarningMb": 2,
      "selfExtractWarningMb": 1
    }
  }
}
